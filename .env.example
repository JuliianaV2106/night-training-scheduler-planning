# SQLite database file (created and migrated on startup). Use :memory: for a throwaway run.
DATABASE_PATH=data/scheduler.db
# Simulated campus instant the service starts at (ISO-8601, must carry the America/Bogota -05:00 offset).
SIM_START_INSTANT=2026-10-18T14:30:00-05:00
# Python logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
